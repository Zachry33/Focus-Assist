{
    "manifest_version": 3,
    "name": "Focus Assist",
    "version": "1.0",
    "description": "Reduce short form content consumption by removing, blocking and limiting them from webpages such as youtube or twitter",
    
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },

    "content_scripts": [
        {
            "js": ["scripts/youtube.js"],
            "matches": [
                "https://www.youtube.com/*"
            ],
            "run_at": "document_start"
        },
        {
            "js": ["scripts/twitter.js"],
            "matches": [
                "https://twitter.com/*",
                "https://x.com/*"
            ],
            "run_at": "document_start"
        }
    ]

}